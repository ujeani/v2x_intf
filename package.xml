  <version>0.0.0</version>
  <description>ROS 2 UDP bridge for V2X recognition messages</description>
  <maintainer email="woojin@ite-telecom.co.kr">woojin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
